# doc-merger 后端环境变量
# 复制为 .env 后由 dotenv 加载（也可用 PM2 ecosystem 注入）

# 服务端口
PORT=3010

# 上传档案大小上限（bytes）
MAX_FILE_SIZE=10485760

# 单次最大档案数
MAX_FILES=50

# 临时档案保留时长（分钟，超过后清理任务会删除）
CLEANUP_AGE_MINUTES=60

# Gitee Webhook 密钥（与 Gitee 仓库管理填入的一致）
# 修改 deploy/webhook-server.js 的 WEBHOOK_TOKEN 保持一致
WEBHOOK_TOKEN=replace-with-random-string
